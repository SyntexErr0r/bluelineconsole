<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground">

    <!-- 1st Line: Header with Settings Icon at the Left & Status Summary -->
    <LinearLayout
        android:id="@+id/appLockTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:background="#1a00f0ff">

        <!-- Settings Icon Button at the Left of 1st Line -->
        <LinearLayout
            android:id="@+id/appLockBtnOpenSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_settings_cyber"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SETTINGS"
                android:textColor="#00f0ff"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Status Summary on 1st Line -->
        <TextView
            android:id="@+id/appLockTopStatusSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="System: ON | Time Lock: ON"
            android:textColor="#99d6ea"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="end"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Below 1st Line: Search Input Field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <EditText
            android:id="@+id/appLockSearchEdit"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/cyber_glass_input_box"
            android:hint="🔍 Search apps to configure..."
            android:textColor="#00f0ff"
            android:textColorHint="#4d7a94"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Below Search: Complete List of Apps (Takes full remaining space) -->
    <ListView
        android:id="@+id/appLockAppListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#2000f0ff"
        android:dividerHeight="1dp"
        android:fastScrollEnabled="true" />
</LinearLayout>
