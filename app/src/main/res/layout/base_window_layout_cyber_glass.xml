<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/baseWindowMainLayoutRoot"
    android:animateLayoutChanges="true"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:clickable="false"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".applicationMain.BaseWindowActivity"
    >
    <LinearLayout
        android:id="@+id/baseWindowRootLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:animateLayoutChanges="true"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:orientation="vertical"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="false"
        >
        <!-- Top-Left Angled Header Tab with glowing cyan diagonal border -->
        <LinearLayout
            android:id="@+id/baseWindowHeaderWrapper"
            android:layout_height="24sp"
            android:layout_width="160sp"
            android:layout_gravity="start"
            android:layout_marginBottom="-2dp"
            android:background="@drawable/cyber_glass_header"
            android:orientation="horizontal"
            android:animateLayoutChanges="true"
            android:gravity="center_vertical|start"
            android:paddingStart="12sp"
            android:paddingEnd="18sp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            tools:ignore="KeyboardInaccessibleWidget"
            >
            <TextView
                android:clickable="false"
                android:id="@+id/baseWindowMainHeaderTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:textColor="#00f0ff"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:text=""
                android:textSize="12sp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                />
        </LinearLayout>

        <!-- Main Window Container with complete glowing cyan border and dark glass fill -->
        <LinearLayout
            android:id="@+id/baseWindowMainLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:paddingHorizontal="8dp"
            android:background="@drawable/cyber_glass_window_frame"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:animateLayoutChanges="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            tools:ignore="KeyboardInaccessibleWidget"
            >
            <ViewStub
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/baseWindowMainViewStub"
                android:animateLayoutChanges="true"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="false"
                />
        </LinearLayout>

        <!-- Bottom-Right Angled Footer Tab with glowing cyan diagonal border -->
        <LinearLayout
            android:id="@+id/baseWindowFooterWrapper"
            android:layout_width="160sp"
            android:layout_height="24sp"
            android:layout_marginTop="-2dp"
            android:layout_gravity="end"
            android:background="@drawable/cyber_glass_footer"
            android:orientation="horizontal"
            android:animateLayoutChanges="true"
            android:gravity="center_vertical|end"
            android:paddingStart="18sp"
            android:paddingEnd="12sp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            tools:ignore="KeyboardInaccessibleWidget"
            >
            <TextView
                android:clickable="false"
                android:id="@+id/baseWindowMainFooterTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:textStyle="bold"
                android:textColor="#00f0ff"
                android:fontFamily="monospace"
                android:text=""
                android:textSize="12sp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
