<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp"
    android:background="?attr/selectableItemBackground">

    <!-- Avatar / Initial Badge -->
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/cyber_avatar_circle">

        <TextView
            android:id="@+id/contactItemAvatarText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="F"
            android:textColor="#00f0ff"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </FrameLayout>

    <!-- Contact Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/contactItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#e6f9ff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/contactItemSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00f0ff"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Right Actions: Call, Message, Pin, Edit -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="4dp">

        <!-- Call Button -->
        <ImageView
            android:id="@+id/contactItemBtnCall"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_call_cyber"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Call Contact" />

        <!-- Message Button -->
        <ImageView
            android:id="@+id/contactItemBtnMessage"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_message_cyber"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Message Contact" />

        <!-- Pin Button -->
        <ImageView
            android:id="@+id/contactItemBtnPin"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_pin_cyber"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Pin Contact" />

        <!-- Edit Button -->
        <ImageView
            android:id="@+id/contactItemBtnEdit"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_customize_cyber"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Edit Contact" />
    </LinearLayout>
</LinearLayout>
