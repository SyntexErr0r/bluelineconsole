<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@android:color/transparent">

    <!-- Switch 1: Master Enable -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Enable App Lock System"
            android:textColor="#e6f9ff"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/dialogGlobalSwitchMasterEnable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="#00f0ff"
            app:trackTint="#6600f0ff" />
    </LinearLayout>

    <!-- Switch 2: Lock All Apps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lock All Downloaded Apps"
            android:textColor="#e6f9ff"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/dialogGlobalSwitchLockAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="#00f0ff"
            app:trackTint="#6600f0ff" />
    </LinearLayout>

    <!-- Switch 3: Dynamic Time Lock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dynamic Time Lock (Aa:Bb -> Ba:Ab)"
            android:textColor="#e6f9ff"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/dialogGlobalSwitchTimeLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="#00f0ff"
            app:trackTint="#6600f0ff" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2600f0ff"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔑 MASTER CREDENTIALS"
        android:textColor="#00f0ff"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp" />

    <!-- Master PIN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/dialogMasterPinInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Master PIN: Rolling Time"
            android:textColor="#99d6ea"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/dialogBtnChangeMasterPin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[Set PIN]"
            android:textColor="#00f0ff"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="6dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/dialogBtnResetMasterPin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[Reset]"
            android:textColor="#ff5577"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Master Pattern -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/dialogMasterPatternInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Master Pattern: Rolling Time"
            android:textColor="#99d6ea"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/dialogBtnDrawMasterPattern"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[Draw Pattern]"
            android:textColor="#00f0ff"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="6dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/dialogBtnResetMasterPattern"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[Reset]"
            android:textColor="#ff5577"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/dialogBtnGlobalDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[Done]"
            android:textColor="#00f0ff"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:padding="8dp" />
    </LinearLayout>
</LinearLayout>
