<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/appLockItemIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/appLockItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#e6f9ff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/appLockItemPackage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#4d7a94"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/appLockItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00f0ff"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/appLockItemActionBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[Edit]"
        android:textColor="#00f0ff"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:padding="6dp" />
</LinearLayout>
