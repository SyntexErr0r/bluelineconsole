<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRootLinearLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="0px"
    android:paddingHorizontal="0px"
    android:orientation="vertical"
    android:animateLayoutChanges="true"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:clickable="false">
    <LinearLayout
        android:id="@+id/mainInputTextWrapperLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0px"
        android:background="?bluelineconsoleFrameColor"
        android:animateLayoutChanges="true"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="false"
        >
        <EditText
            android:id="@+id/mainInputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textSize="40sp"
            android:padding="12sp"
            android:textCursorDrawable="@null"
            android:background="?android:colorBackground"
            android:imeOptions="actionGo|flagForceAscii|flagNoExtractUi|flagNoFullscreen"
            android:animateLayoutChanges="true"
            tools:ignore="LabelFor"
            android:importantForAutofill="no"
            >
            <requestFocus/>
        </EditText>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/appLockWrapperLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:animateLayoutChanges="true"
        android:padding="8dp"
        android:background="?android:colorBackground">

        <!-- App Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp">
            <ImageView
                android:id="@+id/appLockAppIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="App Icon" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/appLockAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="?bluelineconsoleBaseTextColor" />
                <TextView
                    android:id="@+id/appLockStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter PIN or swipe pattern to unlock"
                    android:textSize="12sp"
                    android:textColor="?bluelineconsoleAccentColor" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mode Toggle Tabs (Console style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="4dp">
            <TextView
                android:id="@+id/appLockTabPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="[ 🔢 PIN KEYPAD ]"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?bluelineconsoleAccentColor"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/appLockTabPattern"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="[ 💠 9-DOT PATTERN ]"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?bluelineconsoleDisabledTextColor"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/appLockTabBiometric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="[ 👆 BIOMETRIC ]"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:textColor="?bluelineconsoleDisabledTextColor"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Container for PatternLockView -->
        <net.nhiroki.bluelineconsole.applock.PatternLockView
            android:id="@+id/appLockPatternView"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginVertical="6dp" />

        <!-- Container for PIN Keypad -->
        <LinearLayout
            android:id="@+id/appLockPinKeypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginVertical="4dp">

            <!-- Row 1: 1 2 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <TextView android:id="@+id/btnKey1" android:text="1" style="@style/AppLockKeypadButton" />
                <TextView android:id="@+id/btnKey2" android:text="2" style="@style/AppLockKeypadButton" />
                <TextView android:id="@+id/btnKey3" android:text="3" style="@style/AppLockKeypadButton" />
            </LinearLayout>

            <!-- Row 2: 4 5 6 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <TextView android:id="@+id/btnKey4" android:text="4" style="@style/AppLockKeypadButton" />
                <TextView android:id="@+id/btnKey5" android:text="5" style="@style/AppLockKeypadButton" />
                <TextView android:id="@+id/btnKey6" android:text="6" style="@style/AppLockKeypadButton" />
            </LinearLayout>

            <!-- Row 3: 7 8 9 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <TextView android:id="@+id/btnKey7" android:text="7" style="@style/AppLockKeypadButton" />
                <TextView android:id="@+id/btnKey8" android:text="8" style="@style/AppLockKeypadButton" />
                <TextView android:id="@+id/btnKey9" android:text="9" style="@style/AppLockKeypadButton" />
            </LinearLayout>

            <!-- Row 4: ⌫ 0 ↵ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <TextView android:id="@+id/btnKeyClear" android:text="⌫" style="@style/AppLockKeypadButton" />
                <TextView android:id="@+id/btnKey0" android:text="0" style="@style/AppLockKeypadButton" />
                <TextView android:id="@+id/btnKeyEnter" android:text="↵" style="@style/AppLockKeypadButton" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/candidateViewWrapperLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0px"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="false"
        >
        <ScrollView
            android:id="@+id/commandSearchWaitingNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="top"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="false"
                >
                <ProgressBar
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="20dp"
                    style="?android:attr/progressBarStyle"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="5sp"
                        android:textStyle="bold"
                        android:text="@string/loading_main_caption"
                        android:textSize="18sp"
                        android:textColor="?bluelineconsoleBaseTextColor"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:clickable="false"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/loading_detail_for_command_search"
                        android:textSize="15sp"
                        android:textColor="?bluelineconsoleBaseTextColor"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:clickable="false"
                        />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <ListView
            android:id="@+id/candidateListView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?android:colorBackground"
            android:animateLayoutChanges="true"
            android:padding="0px"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:headerDividersEnabled="true"
            />
    </LinearLayout>
</LinearLayout>
