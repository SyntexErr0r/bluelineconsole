<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cyber Glass (Sci-Fi HUD) Theme Colors -->
    <color name="cyberGlassAccentColor">#00f0ff</color>
    <color name="cyberGlassFrameColor">#3305101a</color>
    <color name="cyberGlassBackgroundColor">#3d030910</color>
    <color name="cyberGlassCommandBackgroundColor">#4d061420</color>
    <color name="cyberGlassTextColor">#e6f9ff</color>
    <color name="cyberGlassFrameTextColor">#00f0ff</color>
    <color name="cyberGlassSelectedItemBackground">#4000f0ff</color>
    <color name="cyberGlassDisabledTextColor">#4d7a94</color>

    <style name="BaseAppThemeCyberGlass" parent="BaseAppThemeDark">
        <item name="android:colorBackground">@color/cyberGlassBackgroundColor</item>
        <item name="bluelineconsoleBackgroundColorOfCommand">@color/cyberGlassCommandBackgroundColor</item>
        <item name="bluelineconsoleFrameColor">@color/cyberGlassFrameColor</item>
        <item name="bluelineconsoleFrameTextColor">@color/cyberGlassFrameTextColor</item>
        <item name="bluelineconsoleAccentColor">@color/cyberGlassAccentColor</item>
        <item name="bluelineconsoleBaseTextColor">@color/cyberGlassTextColor</item>
        <item name="bluelineconsoleSelectedItemBackgroundColor">@color/cyberGlassSelectedItemBackground</item>
        <item name="bluelineconsoleDisabledTextColor">@color/cyberGlassDisabledTextColor</item>
        <item name="android:textColor">@color/cyberGlassTextColor</item>
        <item name="android:textColorPrimary">@color/cyberGlassTextColor</item>
        <item name="android:textColorSecondary">@color/cyberGlassDisabledTextColor</item>
        <item name="android:colorAccent">@color/cyberGlassAccentColor</item>
        <item name="colorAccent">@color/cyberGlassAccentColor</item>
        <item name="android:colorControlActivated">@color/cyberGlassAccentColor</item>
        <item name="colorControlActivated">@color/cyberGlassAccentColor</item>
        <item name="android:colorControlHighlight">@color/cyberGlassSelectedItemBackground</item>
        <item name="colorControlHighlight">@color/cyberGlassSelectedItemBackground</item>
        <item name="android:fontFamily">monospace</item>

        <!-- Preference Theme -->
        <item name="preferenceTheme">@style/CyberGlassPreferenceTheme</item>

        <!-- Dialogs, Alerts and Popups -->
        <item name="alertDialogTheme">@style/CyberGlassAlertDialogTheme</item>
        <item name="android:alertDialogTheme">@style/CyberGlassAlertDialogTheme</item>
        <item name="dialogTheme">@style/CyberGlassAlertDialogTheme</item>
        <item name="android:dialogTheme">@style/CyberGlassAlertDialogTheme</item>
        <item name="popupMenuStyle">@style/CyberGlassPopupMenu</item>
        <item name="android:popupMenuStyle">@style/CyberGlassPopupMenu</item>
    </style>

    <style name="CyberGlassPreferenceTheme" parent="@style/PreferenceThemeOverlay">
        <item name="alertDialogTheme">@style/CyberGlassAlertDialogTheme</item>
        <item name="android:alertDialogTheme">@style/CyberGlassAlertDialogTheme</item>
    </style>

    <style name="CyberGlassAlertDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="colorBackgroundFloating">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:textColor">@color/cyberGlassTextColor</item>
        <item name="android:textColorPrimary">@color/cyberGlassTextColor</item>
        <item name="android:textColorSecondary">@color/cyberGlassDisabledTextColor</item>
        <item name="android:textColorAlertDialogListItem">@color/cyberGlassTextColor</item>
        <item name="textColorAlertDialogListItem">@color/cyberGlassTextColor</item>
        <item name="android:colorAccent">@color/cyberGlassAccentColor</item>
        <item name="colorAccent">@color/cyberGlassAccentColor</item>
        <item name="android:colorControlActivated">@color/cyberGlassAccentColor</item>
        <item name="colorControlActivated">@color/cyberGlassAccentColor</item>
        <item name="android:colorControlHighlight">@color/cyberGlassSelectedItemBackground</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:windowTitleStyle">@style/CyberGlassDialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/CyberGlassDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/CyberGlassDialogButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/CyberGlassDialogButtonStyle</item>
    </style>

    <style name="CyberGlassDialogTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/cyberGlassAccentColor</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CyberGlassDialogButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/cyberGlassAccentColor</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CyberGlassPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/cyber_glass_dialog_background</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="AppThemeCyberGlass" parent="BaseAppThemeCyberGlass">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="AppThemeCyberGlassHome" parent="BaseAppThemeCyberGlass">
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>
</resources>
